{
  "name": "personal-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "sb:login": "supabase login --agent no",
    "sb:deploy": "supabase functions deploy personal-dashboard --project-ref rgyxwhbriukwxfsqjcuz --no-verify-jwt --use-api --agent no",
    "deploy": "node scripts/deploy-pages.mjs",
    "push:api": "node scripts/push-via-api.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "supabase": "^2.117.0",
    "wrangler": "^4.135.0"
  }
}
